{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Testing Swagger APIs.",
        "title": "Catalog API service",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
